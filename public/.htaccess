# ==============================================================================
# YAMURA - Konfiguracja Apache / Webd.pl (.htaccess)
# ==============================================================================

RewriteEngine On

# 1. Wymuszenie bezpiecznego połączenia HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Przekierowanie www na domenę główną (bez www)
RewriteCond %{HTTP_HOST} ^www\.yamura\.pl$ [NC]
RewriteRule ^(.*)$ https://yamura.pl/$1 [L,R=301]

# 3. Zapewnienie ukośnika (trailing slash) dla katalogów podstron
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ $1/ [R=301,L]

# 4. Domyślna strona błędu 404
ErrorDocument 404 /404.html

# 5. Bezpieczeństwo i ochrona wrażliwych plików
<FilesMatch "^(\.|yamura-contact-secrets|composer\.|package\.json|tsconfig)">
  Require all denied
</FilesMatch>

# 6. Nagłówki bezpieczeństwa HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 7. Kompresja GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon font/woff2 font/woff application/font-woff
</IfModule>

# 8. Cache'owanie statycznych zasobów (optymalizacja PageSpeed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# 9. Obsługa kodowania UTF-8
AddDefaultCharset UTF-8
