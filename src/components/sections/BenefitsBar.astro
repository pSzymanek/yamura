---
import Icon from "../ui/Icon.astro";
import { getLangFromUrl, useTranslations, type Locale } from "../../i18n";

type Props = {
  lang?: Locale;
};

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<section class="benefits-bar" aria-label={t.benefits.ariaLabel}>
  <div class="benefits-bar__inner">
    {t.benefits.items.map((benefit) => (
      <article class="benefit-item" data-reveal>
        <Icon name={benefit.icon} />
        <div>
          <h3>{benefit.title}</h3>
          <p>{benefit.text}</p>
        </div>
      </article>
    ))}
  </div>
</section>
