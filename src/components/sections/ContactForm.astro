---
import { site } from "../../data/site";
import SectionHeading from "../ui/SectionHeading.astro";

const emailHref = `mailto:${site.email}?subject=Zapytanie%20o%20realizacj%C4%99%20YAMURA`;
---

<section class="contact section-light" id="kontakt">
  <div class="section-inner contact__grid">
    <div class="contact__details" data-reveal>
      <SectionHeading eyebrow="Kontakt" title="Porozmawiajmy o Twojej realizacji." align="left" />
      <dl>
        <div>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Lokalizacja</dt>
          <dd>{site.location}</dd>
        </div>
        <div>
          <dt>Siedziba</dt>
          <dd>{site.registeredAddress.street}<br />{site.registeredAddress.postalCode} {site.registeredAddress.city}</dd>
        </div>
      </dl>
    </div>
    <div class="contact-card" data-reveal>
      <p class="eyebrow">Bezpośredni kontakt</p>
      <h2>Opowiedz nam o swojej przestrzeni.</h2>
      <p>
        Napisz, jakich mebli potrzebujesz, gdzie będzie realizowany projekt i jaki termin bierzesz pod uwagę.
        Odpowiemy e-mailem i ustalimy kolejny krok.
      </p>
      <a class="btn btn--dark" href={emailHref}>Napisz wiadomość</a>
      <p class="contact-card__company">{site.owner} · NIP {site.nip} · REGON {site.regon}</p>
    </div>
  </div>
</section>
