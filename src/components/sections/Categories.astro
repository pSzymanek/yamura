---
import { categories } from "../../data/categories";
import CategoryCard from "../ui/CategoryCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="categories section-light" id="oferta" aria-labelledby="categories-title">
  <div class="section-inner">
    <SectionHeading
      title="Meble na wymiar"
      text="Od projektu po montaż - kompleksowa realizacja mebli do domu, biura i przestrzeni komercyjnych. Z dbałością o każdy detal."
    />
    <div class="categories__grid" aria-labelledby="categories-title">
      {categories.map((category) => <CategoryCard category={category} />)}
    </div>
  </div>
</section>
