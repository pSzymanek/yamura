---
import Button from "../ui/Button.astro";
import { getLangFromUrl, getLocalizedPath, useTranslations, type Locale } from "../../i18n";

type Props = {
  lang?: Locale;
};

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const aboutHref = getLocalizedPath("/o-nas/", lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__image">
    <img src="/images/hero/kuchnia-salon.webp" alt="Nowoczesna kuchnia z drewnianą zabudową i wyspą" width="1536" height="1024" fetchpriority="high" />
  </div>
  <div class="hero__copy" data-reveal>
    <img class="hero__logo" src="/images/logo/yamura-dark.png" alt="YAMURA" width="520" height="126" />
    <h1 id="hero-title" set:html={t.hero.title} />
    <span aria-hidden="true"></span>
    <p>
      {t.hero.description}
    </p>
    <p class="hero__provenance">
      <span aria-hidden="true"></span>
      {t.hero.provenance}
    </p>
    <div class="hero__actions">
      <Button href={aboutHref}>{t.hero.ctaButton}</Button>
      <a class="hero__arrow" href="#oferta" aria-label={t.hero.arrowAriaLabel}>
        <svg viewBox="0 0 42 14" aria-hidden="true">
          <path d="M1 7h38m-6-6 7 6-7 6" />
        </svg>
      </a>
    </div>
  </div>
</section>
