---
import Button from "../ui/Button.astro";
import { site } from "../../data/site";
import { getLangFromUrl, getLocalizedPath, useTranslations, type Locale } from "../../i18n";

type Props = {
  lang?: Locale;
};

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const contactHref = getLocalizedPath("/kontakt/", lang);
---

<section class="contact-cta">
  <div class="contact-cta__inner" data-reveal>
    <img src="/images/logo/yamura-light.png" alt="YAMURA" width="300" height="74" loading="lazy" />
    <h2>{t.contactCTA.title}</h2>
    <p>{t.contactCTA.description}</p>
    <div>
      <Button href={contactHref} variant="champagne">{t.contactCTA.consultationButton}</Button>
      <Button href={`mailto:${site.ordersEmail}`} variant="light">{t.contactCTA.emailButton}</Button>
    </div>
  </div>
</section>
