---
import Button from "../ui/Button.astro";
import { site } from "../../data/site";
---

<section class="contact-cta">
  <div class="contact-cta__inner" data-reveal>
    <img src="/images/logo/yamura-light.png" alt="YAMURA" width="300" height="74" loading="lazy" />
    <h2>Masz pomysł na swoje wnętrze?</h2>
    <p>Opowiedz nam, czego potrzebujesz. Przygotujemy rozwiązanie dopasowane do Twojej przestrzeni.</p>
    <div>
      <Button href="/kontakt/" variant="champagne">Umów konsultację</Button>
      <Button href={`mailto:${site.ordersEmail}`} variant="light">Napisz do nas</Button>
    </div>
  </div>
</section>
