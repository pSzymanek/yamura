---
import { site } from "../../data/site";
import ContactIcon from "../ui/ContactIcon.astro";
import { getLangFromUrl, useTranslations, type Locale } from "../../i18n";

type Props = {
  lang?: Locale;
};

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<aside class="contact-dock" data-contact-dock aria-label="Quick Contact">
  <div class="contact-dock__links" data-contact-dock-links>
    {site.socialMedia.map((social) => (
      <a href={social.url} target="_blank" rel="noreferrer" aria-label={social.name} data-label={social.name}>
        <ContactIcon name={social.icon} />
      </a>
    ))}
    <a href={`mailto:${site.ordersEmail}`} aria-label={`${t.common.ordersLabel}: ${site.ordersEmail}`} data-label="E-mail">
      <ContactIcon name="mail" />
    </a>
    <a href={`tel:${site.phoneHref}`} aria-label={`${t.common.phoneLabel}: ${site.phone}`} data-label={t.common.phoneLabel}>
      <ContactIcon name="phone" />
    </a>
  </div>
  <button type="button" aria-expanded="false" aria-label="Contact Dock" data-contact-dock-toggle>
    <span data-contact-open><ContactIcon name="contact" /></span>
    <span data-contact-close hidden><ContactIcon name="close" /></span>
  </button>
</aside>

<script>
  import "../../scripts/contactDock";
</script>
