---
import { site } from "../../data/site";
import ContactIcon from "../ui/ContactIcon.astro";
import { getLangFromUrl, getLocalizedPath, useTranslations, type Locale } from "../../i18n";

type Props = {
  lang?: Locale;
};

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const contactHref = getLocalizedPath("/kontakt/", lang);

const pinterest = site.socialMedia.find((social) => social.name === "Pinterest")?.url ?? "https://pl.pinterest.com/yamurameble/";
---

<dialog class="inspiration-prompt" data-inspiration-prompt aria-labelledby="inspiration-prompt-title">
  <div class="inspiration-prompt__shell">
    <picture class="inspiration-prompt__media" aria-hidden="true">
      <source media="(max-width: 699px)" srcset="/images/promo/japandi-mobile.webp" />
      <source media="(max-width: 1099px)" srcset="/images/promo/japandi-tablet.webp" />
      <img src="/images/promo/japandi-desktop.webp" alt="" width="1680" height="945" />
    </picture>

    <button class="inspiration-prompt__close" type="button" data-inspiration-close aria-label={t.common.close}>
      <ContactIcon name="close" />
    </button>

    <div class="inspiration-prompt__content">
      <img class="inspiration-prompt__logo" src="/images/logo/yamura-dark.png" alt="YAMURA" width="288" height="68" />
      <p class="inspiration-prompt__eyebrow">{t.inspirationPrompt.eyebrow}</p>
      <h2 id="inspiration-prompt-title">{t.inspirationPrompt.title}</h2>
      <div class="inspiration-prompt__copy">
        <p>{t.inspirationPrompt.p1}</p>
        <p>{t.inspirationPrompt.p2}</p>
      </div>
      <div class="inspiration-prompt__actions">
        <a class="inspiration-prompt__button inspiration-prompt__button--primary" href={pinterest} target="_blank" rel="noreferrer">
          <span>{t.inspirationPrompt.pinterestButton}</span><span aria-hidden="true">→</span>
        </a>
        <a class="inspiration-prompt__button inspiration-prompt__button--secondary" href={contactHref}>
          <span>{t.inspirationPrompt.contactButton}</span><span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  import "../../scripts/inspirationPrompt";
</script>

<style>
  .inspiration-prompt {
    width: min(1500px, calc(100% - 48px));
    height: min(844px, calc(100dvh - 48px));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: #eee5da;
    color: #29231f;
  }

  .inspiration-prompt[open] {
    animation: inspiration-prompt-enter 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .inspiration-prompt::backdrop {
    background: rgba(12, 11, 10, 0.78);
  }

  .inspiration-prompt[open]::backdrop {
    animation: inspiration-backdrop-enter 320ms ease-out both;
  }

  .inspiration-prompt__shell,
  .inspiration-prompt__media,
  .inspiration-prompt__media img {
    width: 100%;
    height: 100%;
  }

  .inspiration-prompt__shell {
    position: relative;
  }

  .inspiration-prompt__shell::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(249, 246, 242, 0.96) 0%,
      rgba(249, 246, 242, 0.84) 29%,
      rgba(249, 246, 242, 0.38) 45%,
      rgba(249, 246, 242, 0) 59%
    );
    content: "";
    pointer-events: none;
  }

  .inspiration-prompt__media {
    position: absolute;
    inset: 0;
    display: block;
  }

  .inspiration-prompt__media img {
    display: block;
    object-fit: cover;
  }

  .inspiration-prompt__content {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(600px, 39%);
    height: 100%;
    padding: 68px 0 58px 70px;
    flex-direction: column;
    justify-content: center;
  }

  .inspiration-prompt__logo {
    width: 240px;
    height: auto;
    margin-bottom: 44px;
  }

  .inspiration-prompt__eyebrow {
    display: none;
    margin: 0 0 12px;
    color: #9e2e33;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .inspiration-prompt h2 {
    max-width: 520px;
    margin: 0 0 42px;
    font-family: "Cormorant Garamond Light", var(--font-serif);
    font-size: 68px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .inspiration-prompt__copy {
    max-width: 510px;
    font-size: 20px;
    line-height: 1.35;
  }

  .inspiration-prompt__copy p {
    margin: 0;
  }

  .inspiration-prompt__copy p + p {
    margin-top: 24px;
  }

  .inspiration-prompt__actions {
    display: flex;
    gap: 18px;
    margin-top: 42px;
  }

  .inspiration-prompt__button {
    display: inline-flex;
    min-height: 58px;
    padding: 14px 22px;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: 1px solid #9d7144;
    font-size: 15px;
    line-height: 1.25;
    text-align: center;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .inspiration-prompt__button--primary {
    background: #9d7144;
    color: #fff;
  }

  .inspiration-prompt__button--secondary {
    background: rgba(247, 241, 234, 0.72);
    color: #6f4b2d;
  }

  .inspiration-prompt__button--primary:hover,
  .inspiration-prompt__button--primary:focus-visible {
    border-color: var(--color-vermilion);
    background: var(--color-vermilion);
    color: #fff;
  }

  .inspiration-prompt__button--secondary:hover,
  .inspiration-prompt__button--secondary:focus-visible {
    border-color: #9d7144;
    background: #9d7144;
    color: #fff;
  }

  .inspiration-prompt__close {
    position: absolute;
    z-index: 3;
    top: 18px;
    right: 18px;
    display: grid;
    width: 46px;
    height: 46px;
    padding: 11px;
    place-items: center;
    border: 0;
    background: rgba(244, 237, 228, 0.92);
    color: #171513;
    transition: background 180ms ease, color 180ms ease;
  }

  .inspiration-prompt__close:hover,
  .inspiration-prompt__close:focus-visible {
    background: var(--color-vermilion);
    color: #fff;
  }

  .inspiration-prompt__close:focus-visible {
    outline: 0;
    outline-offset: 0;
  }

  @keyframes inspiration-prompt-enter {
    from {
      opacity: 0;
      transform: scale(0.975);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes inspiration-backdrop-enter {
    from {
      background: rgba(12, 11, 10, 0);
    }

    to {
      background: rgba(12, 11, 10, 0.78);
    }
  }

  .inspiration-prompt__close :global(.contact-icon) {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  @media (max-width: 1099px) {
    .inspiration-prompt {
      width: min(920px, calc(100% - 32px));
      height: min(860px, calc(100dvh - 32px));
      overflow-y: auto;
    }

    .inspiration-prompt__shell {
      display: grid;
      min-height: 100%;
      grid-template-rows: minmax(310px, 47%) auto;
    }

    .inspiration-prompt__shell::after {
      display: none;
    }

    .inspiration-prompt__media {
      position: relative;
    }

    .inspiration-prompt__media img {
      object-position: center 48%;
    }

    .inspiration-prompt__content {
      width: auto;
      height: auto;
      padding: 36px 42px 40px;
      justify-content: flex-start;
      background: #f1e9df;
    }

    .inspiration-prompt__logo {
      width: 190px;
      margin-bottom: 24px;
    }

    .inspiration-prompt__eyebrow {
      display: block;
    }

    .inspiration-prompt h2 {
      margin-bottom: 20px;
      font-size: 44px;
    }

    .inspiration-prompt__copy {
      display: grid;
      max-width: none;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      font-size: 16px;
      line-height: 1.55;
    }

    .inspiration-prompt__copy p + p {
      margin-top: 0;
    }

    .inspiration-prompt__actions {
      margin-top: 28px;
    }
  }

  @media (max-width: 699px) {
    .inspiration-prompt {
      width: calc(100% - 20px);
      height: calc(100dvh - 20px);
    }

    .inspiration-prompt__shell {
      grid-template-rows: minmax(250px, 42%) auto;
    }

    .inspiration-prompt__media img {
      object-position: center 42%;
    }

    .inspiration-prompt__content {
      padding: 28px 22px 26px;
    }

    .inspiration-prompt__logo {
      width: 150px;
      margin-bottom: 18px;
    }

    .inspiration-prompt__eyebrow {
      margin-bottom: 8px;
      font-size: 9px;
    }

    .inspiration-prompt h2 {
      margin-bottom: 16px;
      font-size: 36px;
    }

    .inspiration-prompt__copy {
      display: block;
      font-size: 14px;
      line-height: 1.5;
    }

    .inspiration-prompt__copy p + p {
      margin-top: 12px;
    }

    .inspiration-prompt__actions {
      display: grid;
      gap: 10px;
      margin-top: 22px;
    }

    .inspiration-prompt__button {
      width: 100%;
      min-height: 50px;
      padding: 11px 15px;
      font-size: 13px;
    }

    .inspiration-prompt__close {
      top: 10px;
      right: 10px;
      width: 42px;
      height: 42px;
    }
  }

  @media (max-width: 370px), (max-height: 700px) and (max-width: 699px) {
    .inspiration-prompt__shell {
      grid-template-rows: minmax(180px, 32%) auto;
    }

    .inspiration-prompt__content {
      padding: 20px 18px 22px;
    }

    .inspiration-prompt__logo {
      display: none;
    }

    .inspiration-prompt h2 {
      font-size: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inspiration-prompt[open],
    .inspiration-prompt[open]::backdrop,
    .inspiration-prompt__button,
    .inspiration-prompt__close {
      transition: none;
      animation: none;
    }
  }
</style>
