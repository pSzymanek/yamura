---
import { navigation } from "../../data/navigation";
import { site } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img src="/images/logo/yamura-light.png" alt="YAMURA" width="260" height="64" loading="lazy" />
      <p>{site.footerText}</p>
      <p class="site-footer__provenance"><span aria-hidden="true"></span> Polska firma · Polska produkcja · Japońska precyzja</p>
    </div>
    <nav aria-label="Nawigacja w stopce">
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <address>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <span>{site.owner}</span>
      <span>{site.registeredAddress.street}</span>
      <span>{site.registeredAddress.postalCode} {site.registeredAddress.city}</span>
      <span>NIP: {site.nip} · REGON: {site.regon}</span>
    </address>
    <div class="site-footer__bottom">
      <p>© {year} YAMURA. Wszystkie prawa zastrzeżone.</p>
      <nav class="site-footer__legal" aria-label="Dokumenty i prywatność">
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <a href="/regulamin/">Regulamin</a>
        <button type="button" data-cookie-settings>Ustawienia cookies</button>
      </nav>
    </div>
  </div>
</footer>
