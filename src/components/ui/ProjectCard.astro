---
import type { Project } from "../../types";

type Props = {
  project: Project;
  index: number;
};

const { project, index } = Astro.props;
---

<article
  class="project-card"
  data-project-card
  data-project-filters={project.filters.join(",")}
  data-project-index={index}
  data-project-featured={String(project.featured)}
  data-reveal
>
  <button class="project-card__button" type="button" aria-label={`Otwórz realizację: ${project.title}`}>
    <img
      src={project.image}
      alt={project.alt}
      width={project.width}
      height={project.height}
      loading="lazy"
      decoding="async"
    />
    <span class="project-card__content">
      <strong>{project.title}</strong>
    </span>
  </button>
</article>
