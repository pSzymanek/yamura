---
import type { Project } from "../../types";
import { getLangFromUrl, useTranslations, type Locale } from "../../i18n";

type Props = {
  project: Project;
  index: number;
  lang?: Locale;
};

const { project, index, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<article
  class="project-card"
  data-project-card
  data-project-filters={project.filters.join(",")}
  data-project-index={index}
  data-project-featured={String(project.featured)}
  data-reveal
>
  <button class="project-card__button" type="button" aria-label={`${t.projects.openProjectAria}: ${project.title}`}>
    <img
      src={project.image}
      alt={project.alt}
      width={project.width}
      height={project.height}
      loading="lazy"
      decoding="async"
    />
    <span class="project-card__content">
      <strong>{project.title}</strong>
    </span>
  </button>
</article>
