---
type Props = {
  href?: string;
  variant?: "dark" | "light" | "outline" | "champagne";
  class?: string;
};

const { href, variant = "dark", class: className = "" } = Astro.props;
const classes = ["btn", `btn--${variant}`, className].filter(Boolean).join(" ");
---

{href ? (
  <a class={classes} href={href}>
    <slot />
  </a>
) : (
  <button class={classes}>
    <slot />
  </button>
)}
