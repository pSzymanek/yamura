---
type Props = {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: "left" | "center";
};

const { eyebrow, title, text, align = "center" } = Astro.props;
---

<div class={`section-heading section-heading--${align}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  <span aria-hidden="true"></span>
  {text && <p>{text}</p>}
</div>
