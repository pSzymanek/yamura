---
type Props = {
  name: "contact" | "close" | "mail" | "phone" | "pinterest" | "instagram" | "facebook" | "map";
};

const { name } = Astro.props;
---

<svg class="contact-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  {name === "contact" && <><path d="M5 5.5h14v10H9l-4 3v-13Z" /><path d="M8 9h8M8 12h5" /></>}
  {name === "close" && <><path d="m6.5 6.5 11 11M17.5 6.5l-11 11" /></>}
  {name === "mail" && <><rect x="3.5" y="5.5" width="17" height="13" /><path d="m4 7 8 6 8-6" /></>}
  {name === "phone" && <path d="M7.3 3.5 10 8 7.8 9.8c1.3 2.8 3.6 5.1 6.4 6.4L16 14l4.5 2.7-.8 3c-.2.7-.9 1.1-1.6 1-7.5-1-13.8-7.3-14.8-14.8-.1-.7.3-1.4 1-1.6l3-.8Z" />}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r=".8" fill="currentColor" stroke="none" /></>}
  {name === "facebook" && <path d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H8V13h2.8v8h3.4Z" fill="currentColor" stroke="none" />}
  {name === "pinterest" && <path d="M12 3.5a8.5 8.5 0 0 0-3.1 16.4c-.1-1.4 0-3 .4-4.3l1.1-4.7s-.3-.7-.3-1.7c0-1.6.9-2.8 2.1-2.8 1 0 1.5.7 1.5 1.6 0 1-.6 2.4-1 3.8-.3 1.1.6 2 1.7 2 2 0 3.5-2.1 3.5-5.1 0-2.7-1.9-4.6-4.7-4.6-3.2 0-5.1 2.4-5.1 4.9 0 1 .4 2 1 2.5.1.1.1.2.1.4l-.4 1.5c-.1.5-.5.6-.9.4-1.6-.7-2.6-2.8-2.6-4.6 0-3.7 2.7-7 7.7-7 4 0 7.1 2.8 7.1 6.6 0 3.9-2.5 7.1-5.9 7.1-1.2 0-2.3-.6-2.7-1.4l-.7 2.8c-.3 1.3-1.2 2.8-1.8 3.7.9.3 1.9.5 3 .5a8.5 8.5 0 0 0 0-17Z" fill="currentColor" stroke="none" />}
  {name === "map" && <><path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" /><circle cx="12" cy="10" r="2" /></>}
</svg>
