---
import { site } from "../../data/site";
import ContactIcon from "./ContactIcon.astro";
import { getLangFromUrl, useTranslations, type Locale } from "../../i18n";

type Props = {
  compact?: boolean;
  lang?: Locale;
};

const { compact = false, lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={["map-card", compact && "map-card--compact"]}>
  <iframe
    src={site.map.embedUrl}
    title={`${t.common.mapAddressLabel}: ${site.map.address}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    tabindex="-1"
  ></iframe>
  <a href={site.map.googleMapsUrl} target="_blank" rel="noreferrer" aria-label={`${t.common.openInGoogleMaps}: ${site.map.address}`}>
    <span class="map-card__pin"><ContactIcon name="map" /></span>
    <span>
      <strong>YAMURA Meble</strong>
      <small>{site.map.address}</small>
    </span>
  </a>
</div>
