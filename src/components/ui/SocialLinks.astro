---
import { site } from "../../data/site";
import ContactIcon from "./ContactIcon.astro";

type Props = {
  label?: string;
};

const { label = "Social media" } = Astro.props;
---

<div class="social-links" aria-label={label}>
  {site.socialMedia.map((social) => (
    <a href={social.url} target="_blank" rel="noreferrer" aria-label={social.name} title={social.name}>
      <ContactIcon name={social.icon} />
    </a>
  ))}
</div>
